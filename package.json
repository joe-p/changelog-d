{
  "name": "semfrag",
  "version": "0.1.0",
  "description": "Merge changelog.d fragments into a changelog with automatic semantic versioning",
  "type": "module",
  "bin": {
    "semfrag": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check-types": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run format && pnpm run check-types",
    "fix": "pnpm run lint:fix && pnpm run format:fix && pnpm run check-types",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "changelog",
    "changelog.d",
    "release"
  ],
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.6",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
